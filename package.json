{
  "name": "indian-stock-screener",
  "version": "1.0.1",
  "description": "A minimal sortable screener for Indian equities",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Arunava1210",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:app": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "test": "node --test"
  },
  "dependencies": {
    "hyparquet": "1.31.1",
    "hyparquet-compressors": "1.1.2",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "vite": "7.1.11",
    "wait-on": "8.0.4"
  },
  "build": {
    "appId": "in.bharatscreener.desktop",
    "productName": "India Stock Screener",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "category": "Office",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
